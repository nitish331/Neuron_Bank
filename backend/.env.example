MONGODB_URI=mongodb://127.0.0.1:27017/neuron_banking
PORT=3000
JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_different_long_random_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

CLIENT_ORIGINS=http://localhost:3001,http://localhost:3002

# Base URL used to build the password reset link. Falls back to the first
# CLIENT_ORIGINS entry when unset.
CLIENT_APP_URL=http://localhost:3001

# Gmail needs an App Password (16 characters), not your account password.
# Enable 2-Step Verification first, then create one under Google Account security.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_address@gmail.com
SMTP_PASS=your_16_character_app_password
MAIL_FROM=Neuron Bank <your_address@gmail.com>

# 64 hex characters (32 bytes). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Card numbers are encrypted with this, so changing it makes existing cards unreadable.
CARD_ENCRYPTION_KEY=replace_with_64_hex_characters
